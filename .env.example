# SafeCook Pro Environment Variables Example
# Copy this file to .env and replace placeholder values with your environment credentials.

# Application Server Configuration
PORT=8080
NODE_ENV=development
DATABASE_PATH=./safecook.db

# IoT MQTT Broker Configuration (ESP32 Integration)
MQTT_BROKER_URL=mqtts://broker.safecookpro.com:8883
MQTT_CLIENT_ID=safecook_server_01
MQTT_USERNAME=safecook_iot_user
MQTT_PASSWORD=your_mqtt_password_here

# Firebase Cloud Sync Configuration
FIREBASE_PROJECT_ID=safecook-pro-dev
FIREBASE_API_KEY=your_firebase_api_key_placeholder
FIREBASE_AUTH_DOMAIN=safecook-pro-dev.firebaseapp.com
FIREBASE_DATABASE_URL=https://safecook-pro-dev.firebaseio.com

# Safety Threshold Defaults (PPM)
GAS_WARNING_PPM=100
GAS_CRITICAL_PPM=300
AUTO_VALVE_CLOSE_TIMEOUT_SEC=30
